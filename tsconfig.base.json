{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": ["es2019", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "pretty": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2019"
  },
  "include": ["src", "types"],
  "exclude": ["node_modules", "dist"]
}
