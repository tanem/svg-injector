{
  "name": "@tanem/svg-injector",
  "version": "12.1.0",
  "description": "Fast, caching, dynamic inline SVG DOM injection library.",
  "author": "Tane Morgan (https://github.com/tanem)",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/svg-injector.d.mts",
        "default": "./dist/svg-injector.mjs"
      },
      "default": {
        "types": "./dist/svg-injector.d.cts",
        "default": "./dist/svg-injector.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/svg-injector.cjs",
  "module": "dist/svg-injector.mjs",
  "types": "dist/svg-injector.d.cts",
  "sideEffects": false,
  "size-limit": [
    {
      "name": "ESM bundle",
      "path": "dist/svg-injector.mjs",
      "gzip": true,
      "limit": "5.5 kB"
    },
    {
      "name": "CJS bundle",
      "path": "dist/svg-injector.cjs",
      "gzip": true,
      "limit": "5.5 kB"
    }
  ],
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/tanem/svg-injector",
  "bugs": "https://github.com/tanem/svg-injector/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanem/svg-injector.git"
  },
  "keywords": [
    "dom",
    "html",
    "images",
    "img",
    "javascript",
    "scalable-vector-graphics",
    "svg",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.58.2",
    "@size-limit/file": "13.0.2",
    "@types/node": "25.2.3",
    "eslint": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "monocart-coverage-reports": "2.12.12",
    "npm-run-all2": "8.0.4",
    "prettier": "3.8.1",
    "publint": "0.3.22",
    "serve": "14.2.6",
    "shx": "0.4.0",
    "size-limit": "13.0.2",
    "tanem-scripts": "8.0.7",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1"
  },
  "scripts": {
    "build": "run-s clean bundle",
    "bundle": "tsdown",
    "check:format": "prettier --list-different \"**/*.{cjs,cts,js,mjs,mts,ts}\"",
    "check:types": "tsc --noEmit",
    "clean": "run-p clean:*",
    "clean:coverage": "shx rm -rf coverage",
    "clean:dist": "shx rm -rf dist",
    "clean:test-dist": "shx rm -rf test/dist",
    "format": "prettier --write \"**/*.{cjs,cts,js,mjs,mts,ts}\"",
    "lint": "eslint .",
    "package:attw": "attw --pack .",
    "package:publint": "publint",
    "postbuild": "run-s package:*",
    "release": "tanem-scripts release",
    "size": "size-limit",
    "test": "run-s check:* lint build size test:playwright build:examples test:examples:playwright",
    "test:coverage": "run-s check:* lint build size test:playwright:coverage",
    "test:examples": "run-s build build:examples test:examples:playwright",
    "build:examples": "node scripts/build-examples.js",
    "test:examples:playwright": "playwright test --config playwright.examples.config.ts",
    "test:playwright": "playwright test",
    "test:playwright:coverage": "COVERAGE=1 playwright test"
  }
}
